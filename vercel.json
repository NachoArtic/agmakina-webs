{
  "cleanUrls": false,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Access-Control-Allow-Origin", "value": "*" },
      { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=31536000, stale-while-revalidate=86400" }
    ] },
    { "source": "/(.*)\\.pdf", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex" }
    ] }
  ]
}
